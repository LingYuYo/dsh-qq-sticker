{
  "name": "@local/dsh-qq-sticker",
  "version": "0.2.6",
  "private": true,
  "description": "QQ 表情包库：把群友发的表情收进机器人自己的本地库，看图打标签，聊天时自然用出来。合并自 SnowLuma 的 5 个表情包插件。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "test-offline.mjs",
    "test-integration.mjs",
    "test-panel-client.mjs",
    "test-panel-host.mjs",
    "test-tree.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=20"
  }
}
